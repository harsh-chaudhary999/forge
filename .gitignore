__pycache__/
*.py[cod]
*$py.class

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Editor / backup / scratch temp
*~
*.swp
*.swo
*.tmp
*.temp
*.bak

# Local env / secrets (never commit)
.env
.env.*
!.env.example

# Local-only optional smoke trees (verify_smoke uses a temp dir by default)
tools/scan_forge/fixtures/

# Git worktrees
.worktrees/

# Local scratch (manual verifier fixtures)
.scratch/

# Seed test fixtures + self-test run output — LOCAL ONLY, never committed.
# The seed product and its PRDs are our local test scaffold; nothing under here
# (source, generated tests, node deps, or self-test brain output) goes to the remote.
/seed-product/
/seed/
brain/self-test/
**/node_modules/

# Accidental self-symlink at repo root (e.g. ln -s . forge)
/forge

# Non-Claude IDE/tool byproducts (this is the Claude-only branch — don't recommit)
/.codex/
/.agents/
/.cursor/
/.opencode/
